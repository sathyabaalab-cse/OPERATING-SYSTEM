#include<stdio.h>
#include<unistd.h>
#include<sys/types.h>
#include<sys/wait.h>
int main()
{
   pid_t p2;
   p2=fork();
   if(p2<0)
   {
      fprintf(stderr,"fork failed\n");
      return 1;
   }
   else if(p2==0)
   {
      printf("p2:PID=%d,Parent PID=%d\n",getpid(),getppid());
   }
   else
   {
      printf("p1:PID=%d\n",getpid());
      wait(NULL);
   }
   return 0;
}
