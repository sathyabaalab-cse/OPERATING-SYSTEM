#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/shm.h>
int main()
{
    key_t key;
    int shmid;
    char *shm;
    key = ftok("shmfile", 65);
    if (key == -1)
    {
        perror("Error in ftok\n");
        exit(1);
    }
    shmid = shmget(key, 1024, 0666 | IPC_CREAT);
    if (shmid == -1)
    {
        perror("Error in shmget\n");
        exit(1);
    }
    shm = (char *)shmat(shmid, NULL, 0);
    if (shm == (char *)-1)
    {
        perror("Error in shmat\n");
        exit(1);
    }
    printf("Enter the string: ");
    fgets(shm, 1024, stdin);
    shm[strcspn(shm, "\n")] = '\0';
    printf("Producer wrote: %s\n", shm);
    shmdt(shm);
    return 0;
}
