#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>
#include <sys/ipc.h>
#include <sys/msg.h>
struct message
{
    long msg_type;
    char msg_text[100];
};
int main()
{
    key_t key;
    int msgid;
    struct message msg;
    int i;
    int words = 0;
    int inword = 0;
    key = ftok("msgfile", 65);
    if (key == -1)
    {
        perror("Error in ftok\n");
        exit(1);
    }
    msgid = msgget(key, 0666);
    if (msgid == -1)
    {
        perror("Error in msgget\n");
        exit(1);
    }
    if (msgrcv(msgid, &msg, sizeof(msg.msg_text), 1, 0) == -1)
    {
        perror("Error in msgrcv\n");
        exit(1);
    }
    printf("Consumer received: %s\n", msg.msg_text);
    for (i = 0; msg.msg_text[i] != '\0'; i++)
    {
        if (!isspace(msg.msg_text[i]) && inword == 0)
        {
            words++;
            inword = 1;
        }
        else if (isspace(msg.msg_text[i]))
        {
            inword = 0;
        }
    }
    printf("Number of words: %d\n", words);
    if (msgctl(msgid, IPC_RMID, NULL) == -1)
    {
        perror("Error in msgctl\n");
        exit(1);
    }
    return 0;
}
