#include <stdio.h>

#define MAX 20

typedef struct
{
    int pid;
    int at;         // Arrival Time
    int bt;         // Burst Time
    int ct;         // Completion Time
    int tat;        // Turnaround Time
    int wt;         // Waiting Time
    int rt;         // Remaining Time
    int priority;   // Priority
}Process;

/*---------------- Input Function ----------------*/

void input(Process p[], int *n)
{
    int i;

    printf("Enter Number of Processes : ");
    scanf("%d",&(*n));

    for(i=0;i<*n;i++)
    {
        p[i].pid=i+1;

        printf("\nProcess P%d\n",i+1);

        printf("Arrival Time : ");
        scanf("%d",&p[i].at);

        printf("Burst Time   : ");
        scanf("%d",&p[i].bt);

        printf("Priority     : ");
        scanf("%d",&p[i].priority);

        p[i].rt=p[i].bt;
    }
}

/*---------------- Display Function ----------------*/

void display(Process p[],int n)
{
    int i;
    float avgWT=0,avgTAT=0;

    printf("\n-----------------------------------------------------------------\n");
    printf("PID\tAT\tBT\tCT\tTAT\tWT\n");
    printf("-----------------------------------------------------------------\n");

    for(i=0;i<n;i++)
    {
        printf("P%d\t%d\t%d\t%d\t%d\t%d\n",
               p[i].pid,
               p[i].at,
               p[i].bt,
               p[i].ct,
               p[i].tat,
               p[i].wt);

        avgWT+=p[i].wt;
        avgTAT+=p[i].tat;
    }

    printf("-----------------------------------------------------------------\n");

    printf("\nAverage Waiting Time     = %.2f",avgWT/n);
    printf("\nAverage Turnaround Time  = %.2f\n",avgTAT/n);
}

/*---------------- Sort by Arrival Time ----------------*/

void sortArrival(Process p[],int n)
{
    int i,j;
    Process temp;

    for(i=0;i<n-1;i++)
    {
        for(j=i+1;j<n;j++)
        {
            if(p[i].at>p[j].at)
            {
                temp=p[i];
                p[i]=p[j];
                p[j]=temp;
            }
        }
    }
}

/*---------------- FCFS ----------------*/

void fcfs(Process p[],int n)
{
    int i;

    sortArrival(p,n);

    p[0].ct=p[0].at+p[0].bt;

    p[0].tat=p[0].ct-p[0].at;

    p[0].wt=p[0].tat-p[0].bt;

    for(i=1;i<n;i++)
    {
        if(p[i-1].ct<p[i].at)
            p[i].ct=p[i].at+p[i].bt;
        else
            p[i].ct=p[i-1].ct+p[i].bt;

        p[i].tat=p[i].ct-p[i].at;

        p[i].wt=p[i].tat-p[i].bt;
    }

    printf("\n========== FCFS Scheduling ==========\n");

    printf("\nGantt Chart\n\n|");

    for(i=0;i<n;i++)
        printf(" P%d |",p[i].pid);

    printf("\n");

    display(p,n);
}

/*---------------- SJF (Non-Preemptive) ----------------*/

void sjf(Process p[], int n)
{
    int completed[MAX] = {0};
    int count = 0;
    int currentTime = 0;
    int i, index;
    int minBT;

    printf("\n========== SJF Scheduling ==========\n");

    printf("\nGantt Chart\n\n|");

    while(count < n)
    {
        index = -1;
        minBT = 9999;

        /* Find process with minimum burst time among arrived processes */
        for(i = 0; i < n; i++)
        {
            if(p[i].at <= currentTime &&
               completed[i] == 0 &&
               p[i].bt < minBT)
            {
                minBT = p[i].bt;
                index = i;
            }
        }

        /* If no process has arrived, CPU remains idle */
        if(index == -1)
        {
            currentTime++;
            continue;
        }

        currentTime += p[index].bt;

        p[index].ct = currentTime;
        p[index].tat = p[index].ct - p[index].at;
        p[index].wt = p[index].tat - p[index].bt;

        completed[index] = 1;
        count++;

        printf(" P%d |", p[index].pid);
    }

    printf("\n");

    display(p, n);
}
/*---------------- SRTF (Preemptive) ----------------*/

void srtf(Process p[], int n)
{
    int completed = 0;
    int currentTime = 0;
    int shortest = -1;
    int minRT;
    int i;

    /* Initialize Remaining Time */
    for(i = 0; i < n; i++)
        p[i].rt = p[i].bt;

    printf("\n========== SRTF Scheduling ==========\n");

    printf("\nGantt Chart\n\n|");

    while(completed < n)
    {
        shortest = -1;
        minRT = 9999;

        /* Find process with shortest remaining time among arrived processes */
        for(i = 0; i < n; i++)
        {
            if(p[i].at <= currentTime &&
               p[i].rt > 0 &&
               p[i].rt < minRT)
            {
                minRT = p[i].rt;
                shortest = i;
            }
        }

        /* CPU Idle */
        if(shortest == -1)
        {
            currentTime++;
            continue;
        }

        printf(" P%d |", p[shortest].pid);

        /* Execute for 1 unit of time */
        p[shortest].rt--;
        currentTime++;

        /* Process Completed */
        if(p[shortest].rt == 0)
        {
            completed++;

            p[shortest].ct = currentTime;
            p[shortest].tat = p[shortest].ct - p[shortest].at;
            p[shortest].wt = p[shortest].tat - p[shortest].bt;

            if(p[shortest].wt < 0)
                p[shortest].wt = 0;
        }
    }

    printf("\n");

    display(p, n);
}
/*---------------- Round Robin ----------------*/

void roundRobin(Process p[], int n)
{
    int tq;
    int queue[100];
    int front = 0, rear = 0;

    int visited[MAX] = {0};

    int currentTime = 0;
    int completed = 0;
    int i;

    printf("Enter Time Quantum : ");
    scanf("%d", &tq);

    /* Initialize Remaining Time */
    for(i = 0; i < n; i++)
        p[i].rt = p[i].bt;

    /* Find first arriving process */
    int first = 0;
    for(i = 1; i < n; i++)
    {
        if(p[i].at < p[first].at)
            first = i;
    }

    currentTime = p[first].at;
    queue[rear++] = first;
    visited[first] = 1;

    printf("\n========== Round Robin Scheduling ==========\n");
    printf("\nGantt Chart\n\n");

    while(completed < n)
    {
        /* CPU Idle */
        if(front == rear)
        {
            currentTime++;

            for(i = 0; i < n; i++)
            {
                if(!visited[i] && p[i].at <= currentTime)
                {
                    queue[rear++] = i;
                    visited[i] = 1;
                }
            }

            continue;
        }

        int idx = queue[front++];

        printf("| P%d ", p[idx].pid);

        if(p[idx].rt > tq)
        {
            currentTime += tq;
            p[idx].rt -= tq;
        }
        else
        {
            currentTime += p[idx].rt;
            p[idx].rt = 0;

            p[idx].ct = currentTime;
            p[idx].tat = p[idx].ct - p[idx].at;
            p[idx].wt = p[idx].tat - p[idx].bt;

            if(p[idx].wt < 0)
                p[idx].wt = 0;

            completed++;
        }

        /* Add newly arrived processes */
        for(i = 0; i < n; i++)
        {
            if(!visited[i] && p[i].at <= currentTime)
            {
                queue[rear++] = i;
                visited[i] = 1;
            }
        }

        /* Put current process back if unfinished */
        if(p[idx].rt > 0)
            queue[rear++] = idx;
    }

    printf("|\n");

    display(p, n);
}
/*---------------- Priority Scheduling (Non-Preemptive) ----------------*/

void priorityScheduling(Process p[], int n)
{
    int completed[MAX] = {0};
    int currentTime = 0;
    int count = 0;
    int i, index;
    int highestPriority;

    printf("\n========== Priority Scheduling ==========\n");

    printf("\nGantt Chart\n\n|");

    while(count < n)
    {
        index = -1;
        highestPriority = 9999;

        /* Find highest priority process among arrived processes */
        /* Smaller priority number = Higher priority */

        for(i = 0; i < n; i++)
        {
            if(p[i].at <= currentTime &&
               completed[i] == 0)
            {
                if(p[i].priority < highestPriority)
                {
                    highestPriority = p[i].priority;
                    index = i;
                }
                else if(p[i].priority == highestPriority)
                {
                    /* Tie -> FCFS (earlier arrival) */
                    if(p[i].at < p[index].at)
                        index = i;
                }
            }
        }

        /* CPU Idle */
        if(index == -1)
        {
            currentTime++;
            continue;
        }

        printf(" P%d |", p[index].pid);

        currentTime += p[index].bt;

        p[index].ct = currentTime;
        p[index].tat = p[index].ct - p[index].at;
        p[index].wt = p[index].tat - p[index].bt;

        completed[index] = 1;
        count++;
    }

    printf("\n");

    display(p, n);
}
int main()
{
    Process p[MAX], temp[MAX];
    int n;
    int choice;
    int i;

    input(p, &n);

    while(1)
    {
        /* Copy original process details */
        for(i = 0; i < n; i++)
            temp[i] = p[i];

        printf("\n======================================");
        printf("\n      CPU SCHEDULING ALGORITHMS");
        printf("\n======================================");
        printf("\n1. FCFS");
        printf("\n2. SJF");
        printf("\n3. SRTF");
        printf("\n4. Round Robin");
        printf("\n5. Priority Scheduling");
        printf("\n6. Exit");

        printf("\n\nEnter your choice : ");
        scanf("%d", &choice);

        switch(choice)
        {
            case 1:
                fcfs(temp, n);
                break;

            case 2:
                sjf(temp, n);
                break;

            case 3:
                srtf(temp, n);
                break;

            case 4:
                roundRobin(temp, n);
                break;

            case 5:
                priorityScheduling(temp, n);
                break;

            case 6:
                printf("\nProgram Terminated Successfully.\n");
                return 0;

            default:
                printf("\nInvalid Choice! Please Try Again.\n");
        }
    }

    return 0;
}
