#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/shm.h>
#include <sys/sem.h>
#include <sys/types.h>
#include <unistd.h>

#define KEY_NUM 5678  // Unique key for IPC tracking

// Define union semun as specified by System V standards
union semun {
    int val;
    struct semid_ds *buf;
    unsigned short *array;
};

// Helper function to handle atomic wait operations via semop
void sem_wait_sys(int semid, int sem_num) {
    struct sembuf sb = {sem_num, -1, 0}; // -1 decrements the semaphore
    semop(semid, &sb, 1);
}

// Helper function to handle atomic signal operations via semop
void sem_post_sys(int semid, int sem_num) {
    struct sembuf sb = {sem_num, 1, 0};  // +1 increments the semaphore
    semop(semid, &sb, 1);
}

int main() {
    // 1. Create/Access Shared Memory
    int shmid = shmget((key_t)KEY_NUM, sizeof(int), IPC_CREAT | 0666);
    if (shmid < 0) { perror("shmget failed"); exit(1); }

    int *shared_data = (int *)shmat(shmid, NULL, 0);
    if (shared_data == (void *)-1) { perror("shmat failed"); exit(1); }

    // 2. Create Semaphore Set with 2 semaphores (Index 0: Producer, Index 1: Consumer) using semget
    int semid = semget((key_t)KEY_NUM, 2, IPC_CREAT | 0666);
    if (semid < 0) { perror("semget failed"); exit(1); }

    // 3. Initialize all semaphores at once using SETALL
    // Index 0 (Producer) = 1 (Ready to start)
    // Index 1 (Consumer) = 0 (Must wait for producer)
    unsigned short values[2] = {1, 0};
    union semun arg;
    arg.array = values;

    if (semctl(semid, 0, SETALL, arg) < 0) {
        perror("semctl SETALL failed");
        exit(1);
    }

    printf("Producer Process Started (Configured with SETALL).\n");

    while (1) {
        // Wait until the Producer slot is clear (Semaphore 0)
        sem_wait_sys(semid, 0);

        printf("\n[Producer] Enter an integer (or -1 to exit): ");
        if (scanf("%d", shared_data) != 1) {
            *shared_data = -1;
        }

        int current_val = *shared_data;

        // Wake up Consumer (Semaphore 1)
        sem_post_sys(semid, 1);

        if (current_val == -1) {
            break;
        }
    }

    // Detach from shared memory
    shmdt(shared_data);
    printf("[Producer] Exiting...\n");
    return 0;
}
