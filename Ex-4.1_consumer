#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/shm.h>
int main()
{
    key_t key;
    int shmid;
    char *shm;
    int i, j;
    char temp;
    key = ftok("shmfile", 65);
    if (key == -1)
    {
        perror("Error in ftok\n");
        exit(1);
    }
    shmid = shmget(key, 1024, 0666);
    if (shmid == -1)
    {
        perror("Error in shmget\n");
        exit(1);
    }
    shm = (char *)shmat(shmid, NULL, 0);
    if (shm == (char *)-1)
    {
        perror("Error in shmat\n");
        exit(1);
    }
    printf("Consumer read: %s\n", shm);
    i = 0;
    j = strlen(shm) - 1;
    while (i < j)
    {
        temp = shm[i];
        shm[i] = shm[j];
        shm[j] = temp;
        i++;
        j--;
    }
    printf("Reversed string: %s\n", shm);
    shmdt(shm);
    shmctl(shmid,IPC_RMID,NULL);
    return 0;
}
