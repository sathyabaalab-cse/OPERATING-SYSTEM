#include<stdio.h>
#include<unistd.h>
#include<sys/types.h>
#include<sys/wait.h>
int main()
{
   pid_t p2,p3;
   printf("P1 :PID=%d\n",getpid());
   p2=fork();
   if(p2<0)
   {
      perror("Fork failed\n");
   }
   else if(p2==0)
   {
      printf("P2 : PID=%d,Parent PID=%d\n",getpid(),getppid());
   }
   else
   {
      wait(NULL);
      p3=fork();
      if(p3==0)
      {
	 printf("P3 :PID=%d,Parent PID=%d\n",getpid(),getppid());
      }
   }
   return 0;
}
