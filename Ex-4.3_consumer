#include <stdio.h>
#include <stdlib.h>
#include <sys/ipc.h>
#include <sys/msg.h>
struct Student
{
    char name[50];
    int rollno;
    int marks[5];
};
struct message
{
    long msg_type;
    struct Student student;
};
char findGrade(float average)
{
    if (average >= 90)
        return 'A';
    else if (average >= 80)
        return 'B';
    else if (average >= 70)
        return 'C';
    else if (average >= 60)
        return 'D';
    else if (average >= 50)
        return 'E';
    else
        return 'F';
}
int main()
{
    key_t key;
    int msgid;
    struct message msg;
    int i, total = 0;
    float average;
    char grade;
    key = ftok("gradefile2", 65);
    if (key == -1)
    {
        perror("Error in ftok\n");
        exit(1);
    }
    msgid = msgget(key, 0666);
    if (msgid == -1)
    {
        perror("Error in msgget\n");
        exit(1);
    }
    if (msgrcv(msgid, &msg, sizeof(msg.student), 1, 0) == -1)
    {
        perror("Error in msgrcv\n");
        exit(1);
    }
    for (i = 0; i < 5; i++)
    {
        total = total + msg.student.marks[i];
    }
    average = total / 5.0;
    grade = findGrade(average);
    printf("\n========== GRADE SHEET ==========\n");
    printf("Name       : %s\n", msg.student.name);
    printf("Roll No    : %d\n", msg.student.rollno);
    printf("\nSubject Marks\n");
    for (i = 0; i < 5; i++)
    {
        printf("Subject %d  : %d\n",
               i + 1,
               msg.student.marks[i]);
    }
    printf("\nTotal      : %d / 500\n", total);
    printf("Average    : %.2f\n", average);
    printf("Grade      : %c\n", grade);
    if (grade == 'F')
        printf("Result     : FAIL\n");
    else
        printf("Result     : PASS\n");
    printf("=================================\n");
    if (msgctl(msgid, IPC_RMID, NULL) == -1)
    {
        printf("Error in msgctl\n");
        exit(1);
    }
    return 0;
}
