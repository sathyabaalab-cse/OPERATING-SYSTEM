#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/ipc.h>
#include <sys/msg.h>
struct message
{
    long msg_type;
    char msg_text[100];
};
int main()
{
    key_t key;
    int msgid;
    struct message msg;
    key = ftok("msgfile", 65);
    if (key == -1)
    {
        perror("Error in ftok\n");
        exit(1);
    }
    msgid = msgget(key, 0666 | IPC_CREAT);
    if (msgid == -1)
    {
        perror("Error in msgget\n");
        exit(1);
    }
    msg.msg_type = 1;
    printf("Enter the message: ");
    fgets(msg.msg_text, 100, stdin);
    msg.msg_text[strcspn(msg.msg_text, "\n")] = '\0';
    if (msgsnd(msgid, &msg, sizeof(msg.msg_text), 0) == -1)
    {
        perror("Error in msgsnd\n");
        exit(1);
    }
    printf("Producer sent: %s\n", msg.msg_text);
    return 0;
}

