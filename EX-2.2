#include<stdio.h>
#include<unistd.h>
#include<string.h>
#include<ctype.h>
int main()
{
   int fd1[2],fd2[2];
   char wm[100],rm[100],pstatus[20],cstatus[20];
   pipe(fd1);
   pipe(fd2);
   if(fork()==0)
   {
      close(fd1[1]);
      close(fd2[0]);
      printf("PID=%d,PPID=%d\n",getpid(),getppid());
      read(fd1[0],rm,sizeof(rm));
      int d=0;
      int s=0;
      int i;
      for(i=0;rm[i]!='\0';i++)
      {
	 if(isdigit(rm[i]))
	 {
	    d=1;
	 }
	 else if(!isalnum(rm[i]))
	 {
	    s=1;
	 }
      }
      if(strlen(rm)>7 && d && s)
      {
	 strcpy(cstatus,"VALID");
      }
      else
      {
	 strcpy(cstatus,"INVALID");
      }
      write(fd2[1],cstatus,sizeof(cstatus));
      close(fd1[0]);
      close(fd2[1]);
   }
   else
   {
      close(fd1[0]);
      close(fd2[1]);
      printf("PID=%d",getpid());
      printf("Enter a string\n");
      scanf("%s",wm);
      write(fd1[1],wm,strlen(wm)+1);
      read(fd2[0],pstatus,sizeof(pstatus));
      printf("status :%s",pstatus);
      close(fd1[1]);
      close(fd2[0]);
   }
   return 0;
}
